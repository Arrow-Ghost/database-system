    <!-- 17 CHOOSER -->
    <section class="chapter choose" id="choose" data-chapter="Choose" data-part="7">
      <div style="display:grid;gap:20px;max-width:900px">
        <p class="eyebrow">Interactive · decision aid</p>
        <h2 class="h-display" data-split>Which database <em>fits?</em></h2>
        <p class="body-copy">Answer four questions about a workload. The bars show how strongly each model fits. Relational is always on the table.</p>
      </div>
      <div class="ch-grid">
        <form class="ch-q" id="ch-form">
          <fieldset><legend><span>Q1</span>What shape is the data?</legend><div class="chips">
            <input type="radio" name="q1" id="q1a" value="rows" checked /><label for="q1a">Uniform rows</label>
            <input type="radio" name="q1" id="q1b" value="nested" /><label for="q1b">Nested, varied records</label>
            <input type="radio" name="q1" id="q1c" value="events" /><label for="q1c">Time-ordered events</label>
            <input type="radio" name="q1" id="q1d" value="links" /><label for="q1d">Highly connected</label>
            <input type="radio" name="q1" id="q1e" value="blobs" /><label for="q1e">Opaque values by ID</label>
          </div></fieldset>
          <fieldset><legend><span>Q2</span>How will you read it?</legend><div class="chips">
            <input type="radio" name="q2" id="q2a" value="adhoc" checked /><label for="q2a">Ad hoc queries, reports</label>
            <input type="radio" name="q2" id="q2b" value="key" /><label for="q2b">Lookup by ID</label>
            <input type="radio" name="q2" id="q2c" value="fields" /><label for="q2c">Filter on many fields</label>
            <input type="radio" name="q2" id="q2d" value="range" /><label for="q2d">Ranges over time</label>
            <input type="radio" name="q2" id="q2e" value="traverse" /><label for="q2e">Follow relationships</label>
          </div></fieldset>
          <fieldset><legend><span>Q3</span>Multi-record transactions?</legend><div class="chips">
            <input type="radio" name="q3" id="q3a" value="must" checked /><label for="q3a">Essential</label>
            <input type="radio" name="q3" id="q3b" value="some" /><label for="q3b">Occasionally</label>
            <input type="radio" name="q3" id="q3c" value="no" /><label for="q3c">Rarely</label>
          </div></fieldset>
          <fieldset><legend><span>Q4</span>Expected scale?</legend><div class="chips">
            <input type="radio" name="q4" id="q4a" value="one" checked /><label for="q4a">One server is fine</label>
            <input type="radio" name="q4" id="q4b" value="grow" /><label for="q4b">Growing fast</label>
            <input type="radio" name="q4" id="q4c" value="huge" /><label for="q4c">Massive, global</label>
          </div></fieldset>
          <div class="btn-row"><button type="button" class="btn" data-preset="bank">Example: bank ledger</button><button type="button" class="btn" data-preset="iot">Example: smart meters</button><button type="button" class="btn" data-preset="social">Example: social network</button><button type="button" class="btn" data-preset="shop">Example: product catalogue</button></div>
        </form>
        <aside class="panel ch-result" aria-live="polite">
          <div class="panel-head"><span>Best fit</span><span class="dots"><i></i><i></i><i></i></span></div>
          <div class="panel-body">
