<!-- TRANSFER COST LAB -->
<section class="chapter cost" id="cost" data-scene="sites" data-chapter="Transfer cost lab" data-part="1">
  <div class="cost-head">
    <div class="stack-v">
      <p class="eyebrow">Data transfer cost · the textbook example</p>
      <h2 class="h-display" data-split>Move the <em>small</em> table.</h2>
    </div>
    <div class="stack-v">
      <p class="body-copy">EMPLOYEE lives at site 1: <strong>10,000 rows × 100 bytes = 1,000,000 bytes</strong>. DEPARTMENT lives at site 2: <strong>100 rows × 35 bytes = 3,500 bytes</strong>. The query arrives at a result site. Every strategy gives the same answer but moves a very different number of bytes.</p>
    </div>
  </div>
  <div class="cost-grid">
    <article class="panel cost-stage">
      <div class="panel-head"><span id="cost-head">Q at site 3</span><span class="tag kv" id="cost-total">0 bytes</span></div>
      <div class="panel-body">
        <svg class="cost-svg" id="cost-svg" viewBox="0 0 560 330" role="img" aria-label="Three sites and the data moved between them"></svg>
        <pre class="term" id="cost-log" style="min-height:4.6em"></pre>
      </div>
    </article>
    <aside class="cost-ctl stack-v">
      <fieldset class="chips-set"><legend>Query</legend><div class="chips">
        <input type="radio" name="cq" id="cq1" value="Q" checked /><label for="cq1">Q · each employee + their department name</label>
        <input type="radio" name="cq" id="cq2" value="Q2" /><label for="cq2">Q′ · each department + its manager’s name</label>
      </div></fieldset>
      <fieldset class="chips-set"><legend>Result needed at</legend><div class="chips">
        <input type="radio" name="cs" id="cs3" value="3" checked /><label for="cs3">Site 3 (neither table)</label>
        <input type="radio" name="cs" id="cs2" value="2" /><label for="cs2">Site 2 (DEPARTMENT)</label>
      </div></fieldset>
      <div class="cost-strats" id="cost-strats"></div>
      <button type="button" class="btn solid" id="cost-run">Run this strategy</button>
      <p class="note">Result rows are 40 bytes (first name, last name, department name). Q returns 10,000 rows, Q′ only 100. CPU and disk costs are ignored here because shipping data usually costs far more.</p>
    </aside>
  </div>
</section>
